{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "voicebox-server",
  "main": "src/index.js",
  "compatibility_date": "2025-10-01",
  "observability": {
    "enabled": true
  },
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "voicebox-sync",
      "database_id": "7b1e9c2a-5d4f-4a3b-9e8c-1f2a3b4c5d6e"
    }
  ],
  "kv_namespaces": [
    {
      "binding": "FILES",
      "id": "5c0f3a9e2b7d4e1f8a6c9b2d4e7f1a3c"
    }
  ]
}
